Процедура ВыполнитьАутентификацию(Логин) Экспорт
	
	
	Соединение    = Новый HTTPСоединение("192.168.0.25",,"MobileClient");
	Запрос        = Новый HTTPЗапрос("beautysalon/hs/users/getUser?username="+Логин);
	Ответ        = Соединение.Получить(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст =("При попытке аутентификации произошла ошибка! Код: " + Ответ.КодСостояния);
		СообщениеПользователю.Сообщить();
		Возврат;
	КонецЕсли;
	
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	
	ЕстьПользователь = Булево(ТелоОтвета);
	
	Если ЕстьПользователь Тогда
		АвторизоватьПользователя(Логин);
	Иначе
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = ("По логину " + Логин + " пользователь не найден!") ;		
		СообщениеПользователю.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры    

