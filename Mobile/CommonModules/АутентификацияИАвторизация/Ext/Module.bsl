Процедура АвторизоватьПользователя(Логин) Экспорт
	
	НовыйПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
	НовыйПользовательИБ.Имя = Логин;
	НовыйПользовательИБ.Роли.Добавить(Метаданные.Роли.АвторизованныйПользователь);
	НовыйПользовательИБ.Записать();
	
	ТекущийПользователь = Справочники.Пользователи.НайтиПоРеквизиту("Логин",Логин);
	
	Если ТекущийПользователь.Пустая() Тогда
		НовыйПользователь = Справочники.Пользователи.СоздатьЭлемент();
		НовыйПользователь.Логин = Логин;
		НовыйПользователь.Наименование = Логин;
		НовыйПользователь.Записать(); 
		ТекущийПользователь = НовыйПользователь.Ссылка; 
	КонецЕсли;
	
	ПараметрыСеанса.ТекущийПользователь = ТекущийПользователь;
	
КонецПроцедуры

Процедура Разлогиниться() Экспорт  
	
	Если ПользователиИнформационнойБазы.ПолучитьПользователей().Количество() > 0 Тогда
		ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
		
		// Удаляем пользователя из информационной базы
		ТекущийПользовательИБ.Удалить();
		
		// Теперь удаляем запись из справочника «Пользователи»
		Отбор = Новый Структура;
		Отбор.Вставить("ИмяПользователяИБ", ТекущийПользовательИБ.Имя); // предполагаем, что поле в справочнике называется «ИмяПользователяИБ»
		
		Выборка = Справочники.Пользователи.Выбрать(, Отбор);
		
		Если Выборка.Следующий() Тогда
			ОбъектПользователя = Выборка.ПолучитьОбъект(); // получаем объект записи
			ОбъектПользователя.Удалить(); // удаляем запись
		КонецЕсли;
	КонецЕсли;
	
		
КонецПроцедуры